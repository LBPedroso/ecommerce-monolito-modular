{
  "name": "ecommerce-monolito-modular",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "setup": "npm run docker:up && npm run prisma:migrate && npm run prisma:seed",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "prisma": "6.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  }
}
